# 로컬 테스트용. 복사해서 .env 로 저장 (.env는 git에 올라가지 않음)
# GitHub에서는 Settings > Secrets and variables > Actions 에 같은 이름으로 넣으세요.

# 운영 스위치 (처음엔 그대로 두세요)
DRY_RUN=true
UPLOAD_ENABLED=false
TEST_MODE=false          # true면 API 호출 없이 fixtures/ 샘플 데이터로 영상만 만듭니다

# 1) 수집 (필수)
YOUTUBE_API_KEY=

# 2) 유튜브 업로드 (OAuth)
YT_CLIENT_ID=
YT_CLIENT_SECRET=
YT_REFRESH_TOKEN=

# 3) 인스타그램 (Instagram Graph API, 비즈니스/크리에이터 계정)
IG_USER_ID=
IG_ACCESS_TOKEN=

# 4) 틱톡 (Content Posting API, 앱 심사 통과 후)
TIKTOK_ACCESS_TOKEN=
TIKTOK_AUDITED=false

# 5) 선택: 제목/설명 생성에 Claude API 사용 (settings.json meta.useClaudeApi=true 일 때만)
ANTHROPIC_API_KEY=
